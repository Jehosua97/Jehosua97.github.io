# Optional. Only needed if you want the contact form to send e-mail directly
# through EmailJS instead of falling back to a mailto: composer.
#
# 1. Create a free account at https://www.emailjs.com/
# 2. Add these three values as repository secrets (Settings > Secrets and
#    variables > Actions) so the GitHub Actions build can read them, or set
#    them here for local development.
# 3. Leave any of them blank to keep the mailto: fallback active.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
